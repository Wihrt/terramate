apiVersion: terramate.io/cli/v1
kind: BundleInstance
metadata:
  name: my-bundle
  uuid: 00000000-0000-0000-0000-000000000001
spec:
  source: /bundles/vpc
  inputs:
    # tmdoc: Region
    region: fr-par
    # tmdoc: Name
    name: main
environments:
  staging:
    source: /bundles/vpc
    inputs:
      # tmdoc: Name
      name: staging-main
